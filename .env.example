# Placeholder Bank synthetic LOCAL demonstration. Do not use production secrets.
# Generate .env with iam/init.ps1 or sh iam/init.sh; these preserve existing keys.
# Do not copy this file over an existing .env or change passwords/encryption keys
# belonging to initialized database/storage volumes.
# New environments use this slug. Existing environments retain their current
# Compose identity (the original fallback is finance-loan-origination).
COMPOSE_PROJECT_NAME=placeholder-bank
# All blank credentials below must be populated with independent random values.
LEDGER_BOOTSTRAP_PASSWORD=
LEDGER_MIGRATION_PASSWORD=
LEDGER_DB_PASSWORD=
LOAN_BOOTSTRAP_PASSWORD=
LOAN_MIGRATION_PASSWORD=
LOAN_DB_PASSWORD=
LOAN_ENCRYPTION_KEY=
LOAN_LOCAL_JWT_SECRET=
S3_ACCESS_KEY=loan-local
S3_SECRET_KEY=
AI_PROVIDER=mock
# External AI needs explicit data-handling approval plus an operator-selected model:
AI_MODEL=
AI_ENDPOINT=
AI_API_KEY=
AI_DATA_HANDLING_APPROVED=false
LOAN_DEMO_PORT=18081
LOAN_DEMO_LEDGER_PORT=18080

# Real Keycloak + Redis + BFF overlay; generated by iam/init.*.
IAM_DB_PASSWORD=
IAM_ADMIN_PASSWORD=
BFF_CLIENT_SECRET=
# 32 random bytes, base64 encoded; shared across BFF replicas.
BFF_ENCRYPTION_KEY=
REDIS_PASSWORD=
LOAN_LEDGER_CLIENT_SECRET=
LEDGER_ADMIN_CLIENT_SECRET=
# Synthetic local account passwords (not IAM or financial verification).
IAM_APPLICANT_PASSWORD=
IAM_OFFICER_PASSWORD=
IAM_COMPLIANCE_PASSWORD=
IAM_OPERATIONS_PASSWORD=
IAM_CONFIGURATION_PASSWORD=

