                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;2  Atomic local commit&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Decision / loan / immutable terms&lt;br/&gt;PROVISION job / audit / state&lt;br/&gt;Lifecycle: PENDING_LEDGER_ACCOUNT&lt;br/&gt;Agreement: NOT_ACCEPTED&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/service/DecisionService.java" id="provision-commit">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#edf7ed;strokeColor=#5b9960;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
