                    </mxCell>
                </object>
                <object label="External I/O runs between short local transactions. Document security, provenance, deterministic math and validated AI remain separate." id="processing-subtitle">
                    <mxCell parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#52657c;fontStyle=0;" vertex="1">
