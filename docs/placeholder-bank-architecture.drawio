                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Least-privileged machine principal&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;loan-ledger client credentials; audience ledger-core&lt;br/&gt;SERVICE + ACCOUNT_PROVISIONER + LEDGER_READER&lt;br/&gt;May recover / provision accounts and read balances.&lt;br/&gt;Journal posting and reversal require other authority.&lt;br/&gt;BFF has no ledger or IAM-admin credential.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: iam/bootstrap.py; ledger-core/src/main/java/com/example/ledger/config/LedgerSecurityConfig.java" id="provision-identity">
