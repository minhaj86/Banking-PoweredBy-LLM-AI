                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;account&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;[PK] id; [FK] ledger_id&lt;br/&gt;[UK] ledger_id + code&lt;br/&gt;[UK] id + ledger_id&lt;br/&gt;[UK] ledger_id + external_reference&lt;br/&gt;type; ACTIVE / CLOSED status&lt;br/&gt;enforce_non_negative_balance&lt;br/&gt;No mutable balance column&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/src/main/resources/db/migration/V1__ledger.sql; V3__external_account_provisioning.sql" id="ledger-data-account">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#edf7ed;strokeColor=#5b9960;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;rounded=0;" vertex="1">
