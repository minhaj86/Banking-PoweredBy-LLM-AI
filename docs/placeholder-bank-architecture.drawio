                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Logout and failure behavior&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;POST logout requires CSRF; clear local caches&lt;br/&gt;Signed backchannel logout revokes shared state&lt;br/&gt;Principal-wide portal logout across replicas&lt;br/&gt;Redis unavailable/full: authentication fails closed&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-bff/src/main/java/com/example/bff/security/SharedOidcSessions.java; docs/authentication-and-sessions.md" id="web-logout">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f3f6fa;strokeColor=#a4b1c2;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
