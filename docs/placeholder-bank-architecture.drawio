                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;journal_transaction&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;[PK] id; [FK] ledger_id&lt;br/&gt;[UK] id + ledger_id&lt;br/&gt;description; external_reference; recorded_at&lt;br/&gt;DRAFT → POSTED in the same TX&lt;br/&gt;reversal_of_transaction_id [FK, UK]&lt;br/&gt;Same-ledger original; reversal_reason&lt;br/&gt;Header immutable after finalisation&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/src/main/resources/db/migration/V1__ledger.sql" id="ledger-data-transaction">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#edf7ed;strokeColor=#5b9960;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;rounded=0;" vertex="1">
                        <mxGeometry height="280" width="400" x="1000" y="245" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Account type and normal side&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;ASSET / EXPENSE → DEBIT&lt;br/&gt;LIABILITY / EQUITY / REVENUE → CREDIT&lt;br/&gt;Normal balance = normal-side total&lt;br/&gt;minus opposite-side total.&lt;br/&gt;Protected normal balances cannot go negative.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/src/main/java/com/example/ledger/domain/enums/AccountType.java; ledger-core/src/main/java/com/example/ledger/domain/repository/BalanceRepository.java" id="ledger-data-normal">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f3f6fa;strokeColor=#a4b1c2;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="280" width="310" x="1450" y="245" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;idempotency_record&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;[PK] ledger_id + operation + key&lt;br/&gt;operation: POST / REVERSE&lt;br/&gt;fingerprint SHA-256&lt;br/&gt;transaction_id [UK]&lt;br/&gt;[FK] transaction_id + ledger_id&lt;br/&gt;DEFERRABLE INITIALLY DEFERRED&lt;br/&gt;response_status = 201; created_at&lt;br/&gt;Claim without journal cannot commit&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/src/main/resources/db/migration/V1__ledger.sql" id="ledger-data-idempotency">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#edf7ed;strokeColor=#5b9960;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;rounded=0;" vertex="1">
                        <mxGeometry height="290" width="330" x="50" y="735" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;account_provisioning_request&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;[PK] ledger_id + idempotency_key&lt;br/&gt;[FK] ledger_id → ledger&lt;br/&gt;[FK] ledger_id + external_reference&lt;br/&gt;Deferred FK → account business identity&lt;br/&gt;Requested code / name / type / protection&lt;br/&gt;Append-only separate provisioning replay&lt;br/&gt;Never creates a journal&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/src/main/resources/db/migration/V3__external_account_provisioning.sql" id="ledger-data-provision">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#edf7ed;strokeColor=#5b9960;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;rounded=0;" vertex="1">
                        <mxGeometry height="290" width="400" x="450" y="735" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;journal_entry&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;[PK] id; ledger_id&lt;br/&gt;[FK] transaction_id + ledger_id&lt;br/&gt;[FK] account_id + ledger_id&lt;br/&gt;[UK] transaction_id + line_number&lt;br/&gt;line_number 1..100; DEBIT / CREDIT&lt;br/&gt;amount NUMERIC, positive and exact cents&lt;br/&gt;description; immutable (incl. late INSERT)&lt;br/&gt;No NUMERIC(p,2) silent input rounding&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/src/main/resources/db/migration/V1__ledger.sql" id="ledger-data-entry">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#edf7ed;strokeColor=#5b9960;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;rounded=0;" vertex="1">
                        <mxGeometry height="290" width="400" x="1000" y="735" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;PostgreSQL defense in depth&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Deferred complete-journal trigger at COMMIT&lt;br/&gt;2..100 lines, consecutive numbering&lt;br/&gt;At least two accounts; equal positive totals&lt;br/&gt;Composite FKs prevent cross-ledger writes&lt;br/&gt;Lock accounts in UUID order; read totals after&lt;br/&gt;ACTIVE status and non-negative protection&lt;br/&gt;Exact one-time full reversal; no reversal of reversal&lt;br/&gt;Block journal / entry UPDATE, DELETE, TRUNCATE&lt;br/&gt;Late entry insert requires a locked DRAFT header&lt;br/&gt;Only zero-balance account closure is allowed&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/src/main/resources/db/migration/V1__ledger.sql" id="ledger-data-guards">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#edf7ed;strokeColor=#5b9960;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="475" width="310" x="1450" y="615" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Reports are projections of journal entries&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Balance, trial balance and history are read-only aggregates / ordered queries. No direct balance writes or shadow loan balance.&lt;br/&gt;Runtime ledger_app and Flyway ledger_migrator are separate. INSERT plus narrow state / status UPDATE privileges only.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/src/main/java/com/example/ledger/domain/repository/BalanceRepository.java; ledger-core/src/main/resources/db/migration/V2__runtime_privileges.sql" id="ledger-data-equation">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f3f6fa;strokeColor=#a4b1c2;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="85" width="1350" x="50" y="1080" as="geometry"/>
                    </mxCell>
                </object>
