                <mxCell id="processing-edge-6" edge="1" parent="1" source="processing-parse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#637891;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontColor=#334b65;labelBackgroundColor=#ffffff;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="processing-doccommit" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Bounded upload and isolation&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;10 MiB file / 11 MiB request; serial browser upload and two concurrent uploads per BFF.&lt;br/&gt;Upload intent makes incomplete / orphan candidates discoverable without listing another applicant’s objects.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/resources/application.yml; loan-bff/src/main/java/com/example/bff/api/BackendProxy.java" id="processing-uploadlimits">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f3f6fa;strokeColor=#a4b1c2;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="105" width="820" x="40" y="465" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Unavailable scanner or OCR → explicit review&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Missing scanner never produces CLEAN. Default OCR is unreliable / unavailable.&lt;br/&gt;Reviewer transcription creates a superseding document with REVIEWER_CONFIRMED provenance and requires resubmission.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/document/DocumentExtractor.java; loan-service/src/main/java/com/example/loans/service/ManualExtractionService.java" id="processing-manual">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff0ed;strokeColor=#ce7565;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="105" width="860" x="900" y="465" as="geometry"/>
                    </mxCell>
                </object>
                <object label="ASSESSMENT PIPELINE  |  frozen revision → current evidence → math and checks → advisory → fenced snapshot" id="processing-assess-heading">
                    <mxCell parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=19;fontColor=#36566d;fontStyle=1;" vertex="1">
                        <mxGeometry height="35" width="1720" x="40" y="625" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;1  Frozen revision&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Submit form + document IDs&lt;br/&gt;Freeze product / policy&lt;br/&gt;Revision + ASSESS job&lt;br/&gt;Claim current application&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/service/ApplicationService.java; loan-service/src/main/java/com/example/loans/workflow/OriginationWorker.java" id="processing-snapshot">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eaf1ff;strokeColor=#5078ce;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="165" width="220" x="40" y="700" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;2  Evidence gates&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Wait for queued documents&lt;br/&gt;Clean, complete and fresh&lt;br/&gt;Required categories / periods&lt;br/&gt;Source facts and provenance&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/workflow/OriginationWorker.java" id="processing-gates">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eaf1ff;strokeColor=#5078ce;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="165" width="220" x="290" y="700" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;3  Deterministic math&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;BigDecimal affordability&lt;br/&gt;Income / debt / residual / DSTI&lt;br/&gt;Explicit annuity rounding&lt;br/&gt;Principal reconciles exactly&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/service/AffordabilityService.java; loan-service/src/main/java/com/example/loans/service/AnnuityCalculator.java" id="processing-math">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eaf1ff;strokeColor=#5078ce;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="165" width="220" x="540" y="700" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;4  Verification checks&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;IDENTITY / COMPLIANCE /&lt;br/&gt;OBLIGATIONS adapters&lt;br/&gt;Status, source and expiry&lt;br/&gt;Synthetic local / unavailable&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/integration/kyc/VerificationConfig.java" id="processing-verify">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff3df;strokeColor=#cf943b;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="165" width="220" x="790" y="700" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;5  Advisory model&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Mock / OpenAI / Ollama&lt;br/&gt;Approved financial inputs&lt;br/&gt;Validated financial sources&lt;br/&gt;No tools or decision authority&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/integration/ai" id="processing-ai">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff3df;strokeColor=#cf943b;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="165" width="220" x="1040" y="700" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;6  Validate and fence&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Structured schema + enums&lt;br/&gt;Exact source tuple matching&lt;br/&gt;Reject stale revision / lease&lt;br/&gt;No result after withdrawal&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/integration/ai/AdvisoryValidator.java; loan-service/src/main/java/com/example/loans/workflow/OriginationWorker.java" id="processing-validate">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eaf1ff;strokeColor=#5078ce;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="165" width="220" x="1290" y="700" as="geometry"/>
                    </mxCell>
