                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Explicit persistence boundary&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;JPA: Ledger / Account / immutable reads&lt;br/&gt;JDBC: locks, totals, history, claims, writer&lt;br/&gt;JpaTransactionManager: one DataSource TX&lt;br/&gt;Flyway uses separate migration credentials&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/src/main/java/com/example/ledger/domain/repository; ledger-core/src/main/resources/application.yml" id="posting-repos">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#edf7ed;strokeColor=#5b9960;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
