                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Separation of duties&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;COMPLIANCE_REVIEWER: compliance / legal hold&lt;br/&gt;OPERATIONS: scoped jobs, retries, metrics and audit&lt;br/&gt;PLATFORM_ADMIN: configuration read-only&lt;br/&gt;APPLICANT: own resources; verified email to submit&lt;br/&gt;IAM authentication does not establish financial KYC.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: docs/roles-and-permissions.md; loan-service/src/main/java/com/example/loans/security/Actor.java" id="lifecycle-roles">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f3f6fa;strokeColor=#a4b1c2;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
