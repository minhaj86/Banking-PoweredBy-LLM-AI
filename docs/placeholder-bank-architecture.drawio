    <diagram id="operations" name="10  Deployment, build and verification">
        <mxGraphModel dx="2800" dy="1264" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1260" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <object label="Placeholder Bank  |  10  Deployment, build and verification" id="operations-title">
                    <mxCell parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=29;fontColor=#16324f;fontStyle=1;" vertex="1">
                        <mxGeometry height="45" width="1720" x="40" y="26" as="geometry"/>
                    </mxCell>
                </object>
                <object label="Local Compose topology, initialization order and developer lifecycle. The diagram describes source configuration; it is not a runtime certification." id="operations-subtitle">
                    <mxCell parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=16;fontColor=#52657c;fontStyle=0;" vertex="1">
                        <mxGeometry height="40" width="1720" x="40" y="80" as="geometry"/>
                    </mxCell>
                </object>
                <object label="SOURCE SNAPSHOT 2026-10-30   |   compose*.yaml; module Dockerfiles; scripts/bank.ps1 + bank.sh; docs/developer-commands.md; test source trees   |   Editable native draw.io shapes; arrows show the named interaction." id="operations-footer">
                    <mxCell parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontColor=#66788f;fontStyle=0;" vertex="1">
                        <mxGeometry height="45" width="1720" x="40" y="1190" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;DEFAULT IAM STACK  |  HEALTH / COMPLETION DEPENDENCIES&lt;/b&gt;" id="operations-readiness">
                    <mxCell parent="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eaf1ff;fillOpacity=24;strokeColor=#5078ce;strokeWidth=1;dashed=1;dashPattern=7 5;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;fontFamily=Helvetica;fontSize=17;fontColor=#334b65;container=0;" vertex="1">
                        <mxGeometry height="725" width="960" x="40" y="190" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;b&gt;BUILD, DEV AND VERIFICATION&lt;/b&gt;" id="operations-build">
                    <mxCell parent="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff3df;fillOpacity=24;strokeColor=#cf943b;strokeWidth=1;dashed=1;dashPattern=7 5;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;fontFamily=Helvetica;fontSize=17;fontColor=#334b65;container=0;" vertex="1">
                        <mxGeometry height="725" width="720" x="1040" y="190" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;1  Durable dependencies and IAM&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;PostgreSQL 17.10: ledger-db, loan-db, iam-db. Separate named volumes.&lt;br/&gt;SeaweedFS private S3; ClamAV definitions volume; authenticated Redis; Mailpit.&lt;br/&gt;Keycloak waits for iam-db healthy. Mailpit supplies local verification / reset email.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: compose.yaml; compose.iam.yaml" id="operations-deps">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#edf7ed;strokeColor=#5b9960;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="115" width="890" x="75" y="250" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;2  One-shot setup jobs&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;iam-bootstrap waits for healthy Keycloak + Mailpit; configures realm / clients / users.&lt;br/&gt;storage-bootstrap waits for healthy S3; ensures private loan-evidence bucket.&lt;br/&gt;Bootstrap credentials are separate from BFF and loan runtime identities.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: iam/bootstrap.py; compose.iam.yaml; compose.yaml" id="operations-bootstrap">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f2ecff;strokeColor=#9064c1;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="115" width="890" x="75" y="415" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;3  Ledger readiness and lender ledger&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;ledger waits for healthy ledger-db and completed iam-bootstrap.&lt;br/&gt;ledger-bootstrap waits for ledger readiness; establishes / reuses the SEK lender ledger.&lt;br/&gt;The config volume exposes lender ledger.properties read-only to loans.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: iam/ledger-bootstrap.py; compose.yaml; compose.iam.yaml" id="operations-ledger">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eaf1ff;strokeColor=#5078ce;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="115" width="890" x="75" y="580" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;4  Loan service → BFF replicas → gateway&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;loans waits for ledger-bootstrap, storage-bootstrap, loan-db and ClamAV readiness.&lt;br/&gt;bff-a / bff-b wait for Redis, loans and iam-bootstrap; Redis shares auth across replicas.&lt;br/&gt;web waits for healthy BFFs. Portal :18082; Mailpit UI :18084; IAM admin loopback :18085.&lt;br/&gt;IAM overlay removes loan / ledger host bindings; all financial data services stay private.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: compose.iam.yaml; loan-web/nginx.conf" id="operations-apps">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eaf1ff;strokeColor=#5078ce;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="140" width="890" x="75" y="745" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Independent deployable build outputs&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Root Maven Wrapper + parent POM: Java 21; shared pinned versions.&lt;br/&gt;Reactor: ledger-core / loan-service / loan-bff. No shared ledger JPA module.&lt;br/&gt;Multistage JDK → JRE images; non-root runtime; health probes.&lt;br/&gt;loan-web: locked npm / Node 24 → Vite build → Nginx static image.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: pom.xml; ledger-core/Dockerfile; loan-service/Dockerfile; loan-bff/Dockerfile; loan-web/Dockerfile" id="operations-maven">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff3df;strokeColor=#cf943b;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="155" width="650" x="1075" y="245" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Workflow and development overlay&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Canonical bank.ps1 / bank.sh: doctor, build, start, deps, status, logs.&lt;br/&gt;Docker builds need no host JDK / Maven / Node. Build omits tests.&lt;br/&gt;start / restart wait for readiness. Native workflow uses JDK 21 / Node ≥24.&lt;br/&gt;Dev overlay adds private Vite :5173 / HMR with node_modules volume.&lt;br/&gt;The browser still uses the same :18082 issuer, cookies and callback.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: scripts/bank.ps1; scripts/bank.sh; compose.dev.yaml" id="operations-dev">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#e7f6f3;strokeColor=#209a88;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="185" width="650" x="1075" y="440" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Verification architecture&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Unit: Maven Surefire and frontend Vitest / Testing Library.&lt;br/&gt;Root verify: Failsafe PostgreSQL / Redis / storage Testcontainers.&lt;br/&gt;RealLedgerIT needs the sibling packaged ledger JAR.&lt;br/&gt;Frontend: typecheck, ESLint, component tests and production build.&lt;br/&gt;Real-Keycloak Playwright: OTP, two BFFs, evidence + ledger flows.&lt;br/&gt;Concurrency uses independent connections, barriers / latches; test COMMIT.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: pom.xml; loan-service/src/test; ledger-core/src/test; loan-bff/src/test; loan-web/e2e" id="operations-tests">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff3df;strokeColor=#cf943b;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="215" width="650" x="1075" y="670" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Runtime identity and data preservation&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Preserve volumes: loan-demo-ledger-data, loan-demo-data, loan-demo-objects, loan-demo-config, loan-demo-clamav, loan-iam-data.&lt;br/&gt;New initialization can use placeholder-bank; existing explicit Compose project names and volumes keep their identity.&lt;br/&gt;Stop preserves containers / volumes. Clean uses only scripts/clean-paths.txt; preserve .env, .iam, local keys and user data.&lt;br/&gt;Redis is ephemeral / noeviction: losing it ends browser sessions. Do not use down -v, prune or a database reset as routine recovery.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: compose.yaml; compose.iam.yaml; scripts/clean-paths.txt; AGENTS.md" id="operations-volumes">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#edf7ed;strokeColor=#5b9960;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="190" width="1100" x="40" y="960" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Implemented scope and scaling limits&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;No agreement signing, funding, repayment or BankID workflow.&lt;br/&gt;Local KYC / bureau / compliance are synthetic; AI defaults to mock.&lt;br/&gt;Provider rate / circuit state is per replica; size aggregate quotas.&lt;br/&gt;Health-only Actuator; operational queue / metrics API and safe logs.&lt;br/&gt;Production needs real providers, TLS, secrets, backups and operations.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: README.md; docs/security-and-production-readiness.md; docs/deployment-and-scaling.md" id="operations-limits">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f3f6fa;strokeColor=#a4b1c2;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="190" width="580" x="1180" y="960" as="geometry"/>
                    </mxCell>
                </object>
