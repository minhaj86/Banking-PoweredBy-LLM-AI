                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;3  Commit completion&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Checksum / size / type match&lt;br/&gt;COMPLETE + DOCUMENT job&lt;br/&gt;Durable atomic enqueue&lt;br/&gt;Quarantine still applies&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/service/DocumentService.java" id="processing-enqueue">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eaf1ff;strokeColor=#5078ce;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="160" width="220" x="540" y="255" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;4  Claim and fetch&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Lease + monotonic fence&lt;br/&gt;Read object outside DB TX&lt;br/&gt;Recheck size and checksum&lt;br/&gt;At-least-once worker&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/workflow/OriginationWorker.java" id="processing-claim">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff3df;strokeColor=#cf943b;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="160" width="220" x="790" y="255" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;5  Real ClamAV scan&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;INSTREAM TCP :3310&lt;br/&gt;CLEAN permits extraction&lt;br/&gt;INFECTED quarantines&lt;br/&gt;UNAVAILABLE ≠ clean&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/document/ClamAvScanner.java" id="processing-scan">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff3df;strokeColor=#cf943b;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="160" width="220" x="1040" y="255" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;6  Extract safely&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;PDFBox text / OCR seam&lt;br/&gt;Max 20 PDF pages&lt;br/&gt;Bounded parser executor&lt;br/&gt;Only supported financial lines&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/document/DocumentExtractor.java; loan-service/src/main/java/com/example/loans/workflow/ParserExecutor.java" id="processing-parse">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff3df;strokeColor=#cf943b;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="160" width="220" x="1290" y="255" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;7  Fenced result&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Persist scan + evidence&lt;br/&gt;EXTRACTED / manual review&lt;br/&gt;Audit and job DONE&lt;br/&gt;Only CLEAN can download&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/workflow/OriginationWorker.java; loan-service/src/main/java/com/example/loans/service/DocumentService.java" id="processing-doccommit">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eaf1ff;strokeColor=#5078ce;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="160" width="220" x="1540" y="255" as="geometry"/>
                    </mxCell>
