                <object label="ONE ATOMIC POST / REVERSE TRANSACTION  |  all locks are held until commit" id="posting-protocol-title">
                    <mxCell parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=19;fontColor=#36566d;fontStyle=1;" vertex="1">
                        <mxGeometry height="35" width="1720" x="40" y="595" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;1  Idempotency claim&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Ledger + operation + key&lt;br/&gt;INSERT ON CONFLICT&lt;br/&gt;Future journal UUID + hash&lt;br/&gt;Existing key → new SELECT&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/src/main/java/com/example/ledger/domain/repository/IdempotencyRepository.java" id="posting-claim">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#fff3df;strokeColor=#cf943b;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="165" width="270" x="40" y="660" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;2  Lock ALL accounts&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;SELECT ... FOR UPDATE&lt;br/&gt;PostgreSQL UUID order&lt;br/&gt;Every distinct affected row&lt;br/&gt;Same protocol for reversals&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/src/main/java/com/example/ledger/domain/repository/AccountLockRepository.java" id="posting-locks">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eaf1ff;strokeColor=#5078ce;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="165" width="270" x="330" y="660" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;3  Read fresh aggregates&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Separate SELECT statement&lt;br/&gt;Only after every lock returns&lt;br/&gt;Fresh READ COMMITTED view&lt;br/&gt;No stored mutable balance&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/src/main/java/com/example/ledger/domain/repository/BalanceRepository.java" id="posting-totals">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#edf7ed;strokeColor=#5b9960;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="165" width="270" x="620" y="660" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;4  Validate final balances&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Every account ACTIVE / same ledger&lt;br/&gt;Sum repeated-account deltas&lt;br/&gt;Protected normal balance ≥ 0&lt;br/&gt;Reversal obeys all account rules&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/src/main/java/com/example/ledger/service/impl/PostingRules.java" id="posting-validate">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eaf1ff;strokeColor=#5078ce;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="165" width="270" x="910" y="660" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;5  Write and finalise&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;DRAFT header + every entry&lt;br/&gt;Set state to POSTED&lt;br/&gt;Immutable response snapshot&lt;br/&gt;Claim and writes share one TX&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/src/main/java/com/example/ledger/domain/repository/JournalWriter.java" id="posting-write">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eaf1ff;strokeColor=#5078ce;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="165" width="270" x="1200" y="660" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;6  COMMIT constraints&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Deferred complete-journal check&lt;br/&gt;Balanced / bounded / same ledger&lt;br/&gt;Immutable guards + deferred FK&lt;br/&gt;Success returns only after commit&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/src/main/resources/db/migration/V1__ledger.sql" id="posting-commit">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#edf7ed;strokeColor=#5b9960;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="165" width="270" x="1490" y="660" as="geometry"/>
                    </mxCell>
                </object>
                <mxCell id="posting-edge-7" edge="1" parent="1" source="posting-claim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#637891;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontColor=#334b65;labelBackgroundColor=#ffffff;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="posting-locks" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="posting-edge-8" edge="1" parent="1" source="posting-locks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#637891;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontColor=#334b65;labelBackgroundColor=#ffffff;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="posting-totals" value="">
                    <mxGeometry relative="1" as="geometry"/>
