                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Revision and withdrawal rules&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Editing / uploading in DRAFT, DOCUMENTS_REQUIRED, MANUAL_REVIEW or ASSESSMENT_FAILED returns to DRAFT.&lt;br/&gt;Those editable states may resubmit a new frozen revision. All pre-approval nonterminal states may withdraw.&lt;br/&gt;Controlled retry may move a current ASSESSMENT_FAILED job back to SUBMITTED; old results are rejected.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/service/ApplicationService.java; docs/application-state-machine.md" id="lifecycle-edits">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f3f6fa;strokeColor=#a4b1c2;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="165" width="1000" x="40" y="970" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Atomic approval transaction&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Idempotency claim + append-only decision + unique loan&lt;br/&gt;+ immutable terms / indicative schedule + PROVISION job&lt;br/&gt;+ audit + APPROVED state commit together.&lt;br/&gt;REQUEST_INFORMATION appends a decision / request.&lt;br/&gt;Reconsideration appends work; it does not reopen a final state.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/service/DecisionService.java" id="lifecycle-atomic">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#edf7ed;strokeColor=#5b9960;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
