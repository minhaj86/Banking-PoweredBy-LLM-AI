                    <mxCell parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontColor=#66788f;fontStyle=0;" vertex="1">
                        <mxGeometry height="45" width="1720" x="40" y="1190" as="geometry"/>
                    </mxCell>
                </object>
                <object label="DOCUMENT PIPELINE  |  upload → private quarantine → real scan → bounded extraction" id="processing-doc-heading">
                    <mxCell parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=19;fontColor=#36566d;fontStyle=1;" vertex="1">
                        <mxGeometry height="35" width="1720" x="40" y="190" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;1  Commit upload intent&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Validate PDF / PNG / JPEG&lt;br/&gt;Type, size and image limits&lt;br/&gt;Owner + version + key&lt;br/&gt;PENDING metadata + audit&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/service/DocumentService.java" id="processing-intent">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eaf1ff;strokeColor=#5078ce;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="160" width="220" x="40" y="255" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;2  Store privately&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Generated UUID object key&lt;br/&gt;AES-GCM encryption&lt;br/&gt;S3 put then HEAD check&lt;br/&gt;No DB lock across S3&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/integration/storage/S3DocumentStorage.java" id="processing-store">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#edf7ed;strokeColor=#5b9960;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="160" width="220" x="290" y="255" as="geometry"/>
