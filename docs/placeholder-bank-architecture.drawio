                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eaf1ff;strokeColor=#5078ce;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
