                <mxCell id="posting-edge-9" edge="1" parent="1" source="posting-totals" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#637891;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontColor=#334b65;labelBackgroundColor=#ffffff;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="posting-validate" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="posting-edge-10" edge="1" parent="1" source="posting-validate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#637891;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontColor=#334b65;labelBackgroundColor=#ffffff;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="posting-write" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="posting-edge-11" edge="1" parent="1" source="posting-write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=18;html=1;strokeColor=#637891;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontColor=#334b65;labelBackgroundColor=#ffffff;spacing=4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="posting-commit" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Posted journal invariants&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;2–100 consecutive lines; at least 2 distinct accounts; both sides; total debits = total credits.&lt;br/&gt;BigDecimal / exact NUMERIC; JSON decimal strings; reject implicit rounding and excess scale.&lt;br/&gt;Headers and entries immutable, including late INSERT; same-ledger composite foreign keys.&lt;br/&gt;Only full one-time reversal of an original posted transaction; every entry swaps side exactly.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/src/main/resources/db/migration/V1__ledger.sql; ledger-core/src/main/java/com/example/ledger/domain/valueobject" id="posting-invariants">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#edf7ed;strokeColor=#5b9960;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="240" width="835" x="40" y="900" as="geometry"/>
                    </mxCell>
                </object>
                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Closure, retry and privilege controls&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;Closure: same row lock → separate aggregate read → require zero → ACTIVE to CLOSED.&lt;br/&gt;Replay same key / same fingerprint → original result; changed payload → 409 conflict.&lt;br/&gt;Retry only 40001, 40P01, 55P03; max 3 attempts on fresh transactions with bounded backoff.&lt;br/&gt;Runtime may insert and narrowly finalise state / close status. It cannot alter or delete journals.&lt;br/&gt;No storage, AI, payment or other HTTP call participates in the ledger posting transaction.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: ledger-core/docs/concurrency-and-idempotency.md; ledger-core/src/main/resources/db/migration/V2__runtime_privileges.sql" id="posting-failure">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#f3f6fa;strokeColor=#a4b1c2;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;" vertex="1">
                        <mxGeometry height="240" width="845" x="915" y="900" as="geometry"/>
                    </mxCell>
                </object>
