                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;Durable queue semantics&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;DOCUMENT / ASSESS / PROVISION lanes: 2 each; PURGE: 1.&lt;br/&gt;500 ms scheduler; 5 min leases; 4 attempts by default.&lt;br/&gt;Global admission bound: 10,000 READY / RUNNING jobs.&lt;br/&gt;Unique kind + target + revision; SKIP LOCKED; fenced finish.&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/java/com/example/loans/config/LoanProperties.java; loan-service/src/main/java/com/example/loans/workflow/JobQueue.java" id="processing-queue-policy">
