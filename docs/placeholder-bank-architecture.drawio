                <object label="&lt;div style=&quot;font-family:Helvetica;line-height:1.32;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;application&lt;/b&gt;&lt;div style=&quot;font-size:14px;margin-top:9px&quot;&gt;[PK] id UUID; tenant; applicant&lt;br/&gt;version; state; current_revision&lt;br/&gt;draft (encrypted); legal_hold&lt;br/&gt;product_id / version (nullable V4)&lt;br/&gt;created_at; updated_at; purged_at&lt;/div&gt;&lt;/div&gt;" tooltip="Source: loan-service/src/main/resources/db/migration/V1__origination.sql; V4__portal_metadata.sql" id="loan-data-application">
                    <mxCell parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#edf7ed;strokeColor=#5b9960;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontFamily=Helvetica;fontSize=14;fontColor=#21394e;rounded=0;" vertex="1">
                        <mxGeometry height="250" width="310" x="40" y="245" as="geometry"/>
